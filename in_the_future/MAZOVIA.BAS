REM 2021-01-24
REM ? "WOJTEK"; CHR$(64); "BITOLOGIA.ORG"
REM
REM POLISH OGONKI IN THE "MAZOVIA" STANDARD

CLS

DIM dd(7) AS INTEGER
LET kmax = 18
FOR k = 1 TO kmax
    FOR j = 0 TO 16
        IF j <> 0 THEN COLOR 7 ELSE COLOR 2
        READ a
        t = a
        m = 0
        WHILE m < 8
            dd(m) = t MOD 2
            m = m + 1
            t = t \ 2
        WEND
        FOR m = 7 TO 0 STEP -1
            PRINT CHR$(176 + (dd(m) MOD 2) * 2);
        NEXT
        IF j = 0 THEN
            PRINT "  "; a; "= ASCII"
            PRINT
        ELSE
            PRINT "  "; a
        END IF
    NEXT
    COLOR 7
    PRINT
    PRINT "press any key to show next font... ("; k; "of"; kmax; ")"
    SLEEP
    CLS
NEXT

