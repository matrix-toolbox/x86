REM TETRIS CLONE
REM
REM 1995-05-31 * [U] VERSION 5
REM 2012-08-18 * [S] REFACTORING
REM 2012-08-19 * [S] TEXT MODE
REM 2012-08-20 * [S] GFX IMPROVEMENT
REM
REM IT STILL SUFFERS FROM A FEW BUGS...

SCREEN 13: DEFINT A-Z

REM
REM RECOUNT THE VALUES OF GET-ARRAYS
REM

DIM VOID(200)
GET (0, 0)-(10, 10), VOID

DIM TILE1(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 9, BF
LINE (1, 1)-(9, 9), 1, BF
LINE (0, 0)-(1, 1), 15
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE1

DIM TILE2(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 10, BF
LINE (1, 1)-(9, 9), 2, BF
LINE (0, 0)-(1, 1), 15
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE2

DIM TILE3(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 11, BF
LINE (1, 1)-(9, 9), 3, BF
LINE (0, 0)-(1, 1), 15
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE3

DIM TILE4(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 12, BF
LINE (1, 1)-(9, 9), 4, BF
LINE (0, 0)-(1, 1), 15
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE4

DIM TILE5(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 13, BF
LINE (1, 1)-(9, 9), 5, BF
LINE (0, 0)-(1, 1), 15
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE5

DIM TILE6(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 14, BF
LINE (1, 1)-(9, 9), 6, BF
LINE (0, 0)-(1, 1), 15
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE6

DIM TILE7(200)
LINE (0, 0)-(10, 10), 8, BF
LINE (0, 0)-(9, 9), 15, BF
LINE (1, 1)-(9, 9), 7, BF
PSET (10, 10), 0
GET (0, 0)-(10, 10), TILE7

CLS : RANDOMIZE TIMER
            
CONST DIMX = 11: REM BOARD DIMENSIONS
CONST DIMY = 16

REM X = HORIZONTAL POSITION OF THE BLOCK "CENTER"
REM Y = VERTICAL...

SCORE = 0: LOCATE 1, 1: PRINT "SCORE ="; SCORE
BLOCKNUMBER = 0
LOCATE 1, 14: PRINT "BLOCKS FALLEN ="; BLOCKNUMBER

DIM BOARD(1 TO DIMX, 1 TO DIMY + 1)

GOSUB BOARDRESET
GOSUB BOARDREFRESHINIT
GOSUB NEXTBLOCK

REM MAIN LOOP
REM
DO: Q$ = INKEY$
    IF Q$ = CHR$(0) + "H" THEN GOSUB ROTATE
    IF Q$ = CHR$(0) + "K" THEN GOSUB MOVELEFT
    IF Q$ = CHR$(0) + "M" THEN GOSUB MOVERIGHT
    IF Q$ = CHR$(27) THEN EXIT DO
    GOSUB BOARDREFRESH
    GOSUB CHECKMOVE
    IF MOVEFLAG = 1 THEN GOSUB MOVEDOWN ELSE GOSUB CANNOTMOVE: GOSUB NEXTBLOCK
    LOOP

LOCATE 3, 5
PRINT "TERMINATED": REM NOT STAYED RESIDENT
SLEEP
END

BOARDRESET:
REM
REM CLEAR THE BATTLEFIELD...
REM 0 = CELL IS NOT OCCUPIED
REM 1 = CELL IS OCCUPIED + LEFT + RIGHT + BOTTOM BORDER
REM
FOR BX = 1 TO DIMX
FOR BY = 1 TO DIMY
        BOARD(BX, BY) = 0: NEXT: NEXT

FOR BX = 1 TO DIMX
        BOARD(BX, DIMY + 1) = 1: NEXT
FOR BY = 1 TO DIMY
        BOARD(1, BY) = 1
        BOARD(DIMX, BY) = 1: NEXT
RETURN

REM
REM SOME ADDITIONAL CONDITIONS MUST BE ADDED HERE
REM

ROTATE:
SELECT CASE BLOCKTYPE
       CASE 1: REM BLOCK1
SELECT CASE BLOCKORIENTATION
       CASE 0: BOARD(X - 1, Y) = 0: BOARD(X + 1, Y + 1) = 0: BOARD(X + 1, Y) = 2: BOARD(X + 1, Y - 1) = 2: BLOCKORIENTATION = 1
       CASE 1: BOARD(X, Y + 1) = 0: BOARD(X + 1, Y - 1) = 0: BOARD(X - 1, Y - 1) = 2: BOARD(X, Y - 1) = 2: BLOCKORIENTATION = 2
       CASE 2: BOARD(X + 1, Y) = 0: BOARD(X - 1, Y - 1) = 0: BOARD(X - 1, Y + 1) = 2: BOARD(X - 1, Y) = 2: BLOCKORIENTATION = 3
       CASE 3: BOARD(X - 1, Y + 1) = 0: BOARD(X, Y - 1) = 0: BOARD(X, Y + 1) = 2: BOARD(X + 1, Y + 1) = 2: BLOCKORIENTATION = 0
END SELECT
       REM    0     1     2     3
       REM   -X+
       REM - ...   ..#   ##.   .#.
       REM Y ##. > .## > .## > ##.
       REM + .##   .#.   ...   #.. AND SO ON...

       CASE 2: REM BLOCK2
SELECT CASE BLOCKORIENTATION
       CASE 0: BOARD(X, Y + 1) = 0: BOARD(X - 1, Y + 1) = 0: BOARD(X + 1, Y + 1) = 2: BOARD(X, Y - 1) = 2: BLOCKORIENTATION = 1
       CASE 1: BOARD(X + 1, Y) = 0: BOARD(X + 1, Y + 1) = 0: BOARD(X - 1, Y) = 2: BOARD(X + 1, Y - 1) = 2: BLOCKORIENTATION = 2
       CASE 2: BOARD(X, Y - 1) = 0: BOARD(X + 1, Y - 1) = 0: BOARD(X - 1, Y - 1) = 2: BOARD(X, Y + 1) = 2: BLOCKORIENTATION = 3
       CASE 3: BOARD(X - 1, Y) = 0: BOARD(X - 1, Y - 1) = 0: BOARD(X - 1, Y + 1) = 2: BOARD(X + 1, Y) = 2: BLOCKORIENTATION = 0
END SELECT

       CASE 3: REM BLOCK3
SELECT CASE BLOCKORIENTATION
       CASE 0: BOARD(X - 1, Y) = 0: BOARD(X, Y - 1) = 2: BLOCKORIENTATION = 1
       CASE 1: BOARD(X, Y + 1) = 0: BOARD(X - 1, Y) = 2: BLOCKORIENTATION = 2
       CASE 2: BOARD(X + 1, Y) = 0: BOARD(X, Y + 1) = 2: BLOCKORIENTATION = 3
       CASE 3: BOARD(X, Y - 1) = 0: BOARD(X + 1, Y) = 2: BLOCKORIENTATION = 0
END SELECT

       CASE 4: REM BLOCK4
SELECT CASE BLOCKORIENTATION
       CASE 0: BOARD(X + 1, Y) = 0: BOARD(X - 1, Y) = 0: BOARD(X - 1, Y + 1) = 0: BOARD(X, Y - 1) = 2: BOARD(X, Y + 1) = 2: BOARD(X + 1, Y + 1) = 2: BLOCKORIENTATION = 1
       CASE 1: BOARD(X + 1, Y + 1) = 0: BOARD(X, Y + 1) = 0: BOARD(X, Y - 1) = 0: BOARD(X - 1, Y) = 2: BOARD(X + 1, Y) = 2: BOARD(X + 1, Y - 1) = 2: BLOCKORIENTATION = 2
       CASE 2: BOARD(X - 1, Y) = 0: BOARD(X + 1, Y) = 0: BOARD(X + 1, Y - 1) = 0: BOARD(X - 1, Y - 1) = 2: BOARD(X, Y - 1) = 2: BOARD(X, Y + 1) = 2: BLOCKORIENTATION = 3
       CASE 3: BOARD(X - 1, Y - 1) = 0: BOARD(X, Y - 1) = 0: BOARD(X, Y + 1) = 0: BOARD(X - 1, Y + 1) = 2: BOARD(X - 1, Y) = 2: BOARD(X + 1, Y) = 2: BLOCKORIENTATION = 0
END SELECT

       CASE 5: REM BLOCK5
SELECT CASE BLOCKORIENTATION
       CASE 0: BOARD(X - 1, Y) = 0: BOARD(X + 1, Y) = 0: BOARD(X + 1, Y + 1) = 0: BOARD(X, Y + 1) = 2: BOARD(X, Y - 1) = 2: BOARD(X + 1, Y - 1) = 2: BLOCKORIENTATION = 1
       CASE 1: BOARD(X, Y + 1) = 0: BOARD(X, Y - 1) = 0: BOARD(X + 1, Y - 1) = 0: BOARD(X - 1, Y) = 2: BOARD(X + 1, Y) = 2: BOARD(X - 1, Y - 1) = 2: BLOCKORIENTATION = 2
       CASE 2: BOARD(X - 1, Y) = 0: BOARD(X + 1, Y) = 0: BOARD(X - 1, Y - 1) = 0: BOARD(X, Y - 1) = 2: BOARD(X, Y + 1) = 2: BOARD(X - 1, Y + 1) = 2: BLOCKORIENTATION = 3
       CASE 3: BOARD(X, Y - 1) = 0: BOARD(X, Y + 1) = 0: BOARD(X - 1, Y + 1) = 0: BOARD(X - 1, Y) = 2: BOARD(X + 1, Y) = 2: BOARD(X + 1, Y + 1) = 2: BLOCKORIENTATION = 0
END SELECT

       CASE 6, 7: REM SYMMETRIC BLOCKS DO NOT ROTATE
END SELECT
RETURN

CHECKMOVE:
MOVEFLAG = 1: REM MOVE IS POSSIBLE
FOR BX = 1 TO DIMX
FOR BY = 1 TO DIMY - 0
        IF BOARD(BX, BY) = 2 AND BOARD(BX, BY + 1) = 1 THEN MOVEFLAG = 0: EXIT FOR: REM MOVE IS IMPOSSIBLE
        NEXT: NEXT

RETURN

REM
REM WHEN IN TEXT MODE USE THIS REFRESHING
REM
REM BOARDREFRESH: REM TEXTMODE:
LOCATE 1, 1
FOR BY = 1 TO DIMY + 1: REM SHOW ADDITIONAL BOTTOM LINE
        PRINT
FOR BX = 1 TO DIMX
        PRINT BOARD(BX, BY);
        NEXT: NEXT
RETURN

BOARDREFRESH:
FOR BY = 1 TO DIMY + 1
FOR BX = 1 TO DIMX
        SELECT CASE BLOCKTYPE
        CASE 1:
        IF BOARD(BX, BY) = 2 THEN PUT (BX * 11, BY * 11), TILE1, OR
        CASE 2:
        IF BOARD(BX, BY) = 2 THEN PUT (BX * 11, BY * 11), TILE2, OR
        CASE 3:
        IF BOARD(BX, BY) = 2 THEN PUT (BX * 11, BY * 11), TILE3, OR
        CASE 4:
        IF BOARD(BX, BY) = 2 THEN PUT (BX * 11, BY * 11), TILE4, OR
        CASE 5:
        IF BOARD(BX, BY) = 2 THEN PUT (BX * 11, BY * 11), TILE5, OR
        CASE 6:
        IF BOARD(BX, BY) = 2 THEN PUT (BX * 11, BY * 11), TILE6, OR
        END SELECT

        IF BOARD(BX, BY) = 0 THEN PUT (BX * 11, BY * 11), VOID, AND
        NEXT: NEXT
RETURN

REM
REM INITIAL OPERATION: DRAWS A BORDER AROUND THE BOARD
REM
BOARDREFRESHINIT:
FOR BY = 3 TO DIMY + 1: REM OMIT THE FIRST ONES
FOR BX = 1 TO DIMX
        IF BOARD(BX, BY) = 1 THEN PUT (BX * 11, BY * 11), TILE7, OR
        NEXT: NEXT

PUT (11, 11), TILE4, OR: REM FILL THE FIRST ONES WITH RED
PUT (11, 22), TILE4, OR
PUT (121, 11), TILE4, OR
PUT (121, 22), TILE4, OR
RETURN

MOVEDOWN:

REM AUXILIARY VARIABLE
T = 0
REM IT COUNTS TO FOUR
REM IF FOUR ELEMENTS ARE HANDLED THEN JUMP OUT THE LOOP
REM THAT SHOULD SPEED UP A BIT THE ENTIRE OPERATION

FOR BX = 1 TO DIMX
FOR BY = DIMY TO 1 STEP -1
        IF BOARD(BX, BY) = 2 THEN BOARD(BX, BY) = 0: BOARD(BX, BY + 1) = 2: T = T + 1
        IF T = 4 THEN EXIT FOR
        NEXT: NEXT
Y = Y + 1
RETURN

CANNOTMOVE:
IF Y <= 3 THEN
        LOCATE 3, 5:
        COLOR 4
        PRINT "GAME  OVER";
        SLEEP

        STOP
        END IF

T = 0: REM AUX... (SEE ABOVE)
FOR BX = 1 TO DIMX
FOR BY = 1 TO DIMY
        IF BOARD(BX, BY) = 2 THEN BOARD(BX, BY) = 1: T = T + 1
        IF T = 4 THEN EXIT FOR
        NEXT: NEXT

CHECKLINE:

FOR BY = DIMY TO 1 STEP -1

REM HERE T SERVES AS THE COUNTER OF TILES IN A LINE
T = 0
FOR BX = 2 TO DIMX - 1
        IF BOARD(BX, BY) = 1 THEN T = T + 1
        NEXT BX
        IF T = DIMX - 2 THEN

                REM FULL LINE... MUST BE DELETED

                SCORE = SCORE + DIMY - BY + 1: LOCATE 1, 1: PRINT "SCORE ="; SCORE

                FOR BX = 2 TO DIMX - 1: BOARD(BX, BY) = 0: NEXT: REM CLEAR THE FULL LINE

                FOR TBY = BY - 1 TO 1 STEP -1
                FOR BX = 2 TO DIMX - 1
                        IF BOARD(BX, TBY) = 1 THEN BOARD(BX, TBY) = 0: BOARD(BX, TBY + 1) = 1
                        NEXT: NEXT
                BY = BY + 1
                END IF
        NEXT BY

LOCATE 1, 14: PRINT "BLOCKS FALLEN ="; BLOCKNUMBER
GOSUB BOARDREFRESH
RETURN

MOVELEFT:
MOVELEFTFLAG = 1: REM MOVE LEFT POSSIBLE

FOR BY = DIMY TO 1 STEP -1
FOR BX = 2 TO DIMX
        IF BOARD(BX, BY) = 2 AND BOARD(BX - 1, BY) = 1 THEN MOVELEFTFLAG = 0: EXIT FOR: REM MOVE IS IMPOSSIBLE
        NEXT: NEXT

IF MOVELEFTFLAG = 1 THEN
X = X - 1
FOR BX = 1 TO DIMX
FOR BY = 1 TO DIMY
        IF BOARD(BX, BY) = 2 THEN BOARD(BX, BY) = 0: BOARD(BX - 1, BY) = 2
        NEXT: NEXT
END IF
RETURN

MOVERIGHT:
MOVERIGHTFLAG = 1: REM MOVE RIGHT POSSIBLE

FOR BY = DIMY TO 1 STEP -1
FOR BX = 1 TO DIMX - 1
        IF BOARD(BX, BY) = 2 AND BOARD(BX + 1, BY) = 1 THEN MOVERIGHTFLAG = 0: EXIT FOR: REM MOVE IS IMPOSSIBLE
        NEXT: NEXT

IF MOVERIGHTFLAG = 1 THEN
X = X + 1
FOR BX = DIMX TO 1 STEP -1
FOR BY = 1 TO DIMY
        IF BOARD(BX, BY) = 2 THEN BOARD(BX, BY) = 0: BOARD(BX + 1, BY) = 2
        NEXT: NEXT
END IF

RETURN

REM
REM DRAW A RANDOM BLOCK AT THE TOP OF THE BOARD
REM
NEXTBLOCK:
BLOCKNUMBER = BLOCKNUMBER + 1
X = 6
Y = 1
BLOCKORIENTATION = 0: REM INITIAL BLOCK ORIENTATION
BLOCKTYPE = INT(RND * 6) + 1
ON BLOCKTYPE GOTO BLOCK1, BLOCK2, BLOCK3, BLOCK4, BLOCK5, BLOCK6, BLOCK7

BLOCK1:
BOARD(5, 1) = 2: REM ##
BOARD(6, 1) = 2: REM  ##
BOARD(6, 2) = 2
BOARD(7, 2) = 2
RETURN

BLOCK2:
BOARD(6, 1) = 2: REM  ##
BOARD(7, 1) = 2: REM ##
BOARD(6, 2) = 2
BOARD(5, 2) = 2
RETURN

BLOCK3:
BOARD(5, 1) = 2: REM ###
BOARD(6, 1) = 2: REM  #
BOARD(7, 1) = 2
BOARD(6, 2) = 2
RETURN

BLOCK4:
BOARD(5, 1) = 2: REM ###
BOARD(6, 1) = 2: REM #
BOARD(7, 1) = 2
BOARD(5, 2) = 2
RETURN

BLOCK5:
BOARD(5, 1) = 2: REM ###
BOARD(6, 1) = 2: REM   #
BOARD(7, 1) = 2
BOARD(7, 2) = 2
RETURN

BLOCK6:
BOARD(5, 1) = 2: REM ##
BOARD(5, 2) = 2: REM ##
BOARD(6, 1) = 2
BOARD(6, 2) = 2
RETURN

BLOCK7:
BOARD(6, 1) = 2: REM # : TEMPORARILY NOT IN USE
REM BLOCK7 IS AN OBSOLETE IDEA FROM THE VERSION 1/1995
REM THERE WERE TWO 1-TILE BLOCKS MARKED WITH [+] AND [-]
REM THE PLUS ONE EXPANDS ITSELF TO 9x9 AREA WHEN LANDED
REM WHILE THE MINUS ONE CLEARS THIS AREA
REM
REM    +
REM           +            ***    ###
REM     ##     ##    +##   ***#   ####
REM   #### > #### > #### > ***# > #### 5 TILES ADDED
REM
REM    -
REM           -            ...
REM     ##     ##    -##   ...#      #
REM   #### > #### > #### > ...# >    # 4 TILES DELETED
REM
RETURN

