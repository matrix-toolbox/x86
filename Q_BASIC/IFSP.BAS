REM IFSP
REM ITERATED FUNCTION SYSTEM WITH PROBABILITIES
REM
REM 1996-09-17
REM 1996-10-12 * [U] DATA STORED IN A FILE (COMPLICATED PARSER...)
REM 1997-02-24 * [U] LAST "OLD-FASHIONED" REVISION BEFORE HIATUS
REM 2012-08-16 * [S] ALL GOTOS REMOVED
REM 2012-08-17 * [S] DROP FILE - IFSP KEPT IN DATA STRUCTURE: [6xT]
REM
REM DO NOT EAT THIS FISH

MENUITEMS = 11
COLOURFLAG = 0
CONST HIGHLIGHTLENGTH = 70

GOSUB MENU:

DO: Q$ = INKEY$
    SELECT CASE Q$
           CASE CHR$(0) + "H": GOSUB SELECTU
           CASE CHR$(0) + "P": GOSUB SELECTD
           CASE CHR$(27): EXIT DO
           CASE CHR$(67): GOSUB COLOURSCHEME
           CASE CHR$(99): GOSUB COLOURSCHEME
           CASE CHR$(9): GOSUB VIEWDETAILS
           CASE CHR$(13): GOSUB DRAWIFSP
    END SELECT

LOOP

CLS
PRINT "TERMINATED"
PRINT "SOURCE CODE BASED ON THE IDEA OF 1996"
PRINT "LAST REVISION 2012/08/18 SOPOT"
SLEEP
STOP

RESTORINGDATA:
SELECT CASE IFSPNUMBER
       CASE 1: RESTORE SIERPINSKITRIANGLE
       CASE 2: RESTORE SIERPINSKICARPET
       CASE 3: RESTORE PENTAGON1
       CASE 4: RESTORE PENTAGON2
       CASE 5: RESTORE SNOWFLAKE
       CASE 6: RESTORE IFSP11
       CASE 7: RESTORE IFSP12
       CASE 8: RESTORE FERN
       CASE 9: RESTORE X
       CASE 10: RESTORE TRIANGLE1
       CASE 11: RESTORE TRIANGLE2
       CASE 12: RESTORE ROSE
END SELECT
RETURN

MENU:
REDIM MENU$(MENUITEMS)
FOR IFSPNUMBER = 1 TO MENUITEMS
        GOSUB RESTORINGDATA
        READ MENUVALUE$
        MENU$(IFSPNUMBER) = MENUVALUE$
        NEXT

SCREEN 0: CLS : DEF SEG = &HB800

ITEM = 1
ITEMMAX = 4: REM SHOWS ONLY 5 ELEMENTS IN THE LIST

LOCATE 1, 1
COLOR 15: PRINT " IFSP";
COLOR 7: PRINT " | TAB = VIEW DETAILS | PRESS C TO CHANGE COLOUR METHOD:"
LOCATE 1, 62: PRINT COLOURFLAG

GOSUB HIGHLIGHT
RETURN

SELECTU:
FOR I = 0 TO HIGHLIGHTLENGTH STEP 2: POKE 321 + I + V, 7: NEXT
IF V = 0 THEN
        V = V + 160
        IF ITEM > 1 THEN ITEM = ITEM - 1
        END IF
V = V - 160
GOSUB HIGHLIGHT
RETURN

SELECTD:
FOR I = 0 TO HIGHLIGHTLENGTH STEP 2: POKE 321 + I + V, 7: NEXT
IF V = 160 * ITEMMAX THEN
        V = V - 160
        IF ITEM + ITEMMAX < MENUITEMS THEN ITEM = ITEM + 1
        END IF
V = V + 160
GOSUB HIGHLIGHT
RETURN

HIGHLIGHT:
LOCATE 3, 1
FOR I = ITEM TO ITEM + ITEMMAX
        PRINT " "; : PRINT MENU$(I)
        NEXT: REM 47, 143=BLINKING
FOR I = 0 TO HIGHLIGHTLENGTH STEP 2: POKE 321 + I + V, 15: NEXT
RETURN

COLOURSCHEME:
COLOURFLAG = COLOURFLAG XOR 1
LOCATE 1, 62: PRINT COLOURFLAG
RETURN

VIEWDETAILS:
IFSPNUMBER = ITEM + V / 160
GOSUB RESTORINGDATA

REM CLEAR THE PART OF THE SCREEN BELOW THE MENU
FOR K = 0 TO 2040 STEP 2
        POKE 1180 + K, 0
        NEXT

READ IFNAME$
COLOR 8
LOCATE 8, 1
PRINT
PRINT " "; : PRINT IFNAME$
PRINT
READ NE : REM NUMBER OF EQUATIONS
READ DUMMY
READ DUMMY
READ DUMMY
READ DUMMY
PTOTAL = 0: REM ASSERT EQUAL 1
FOR E = 0 TO NE - 1
        PRINT " ";
        READ A11: PRINT "A=["; : PRINT USING "+##.###"; A11; : PRINT ", ";
        READ A12: PRINT USING "+##.###"; A12; : PRINT ", ";
        READ TX
        READ A21: PRINT USING "+##.###"; A21; : PRINT ", ";
        READ A22: PRINT USING "+##.###"; A22; : PRINT " ], ";
        READ TY: PRINT " T=["; : PRINT USING "+##.###"; TX;
                 PRINT USING "+##.###"; TY; : PRINT "] ";
        READ PVALUE: PRINT "P="; : PRINT USING "#.###"; PVALUE
        PTOTAL = PTOTAL + PVALUE
        READ C
        NEXT
PRINT
PRINT " SUM OF PROBABILITIES ="; PTOTAL
COLOR 7
RETURN

DRAWIFSP:
IFSPNUMBER = ITEM + V / 160
GOSUB RESTORINGDATA

READ IFSPNAME$
READ NUMBEROFEQUATIONS

REDIM AX(NUMBEROFEQUATIONS)
REDIM AY(NUMBEROFEQUATIONS)
REDIM BX(NUMBEROFEQUATIONS)
REDIM BY(NUMBEROFEQUATIONS)
REDIM TX(NUMBEROFEQUATIONS)
REDIM TY(NUMBEROFEQUATIONS)
REDIM P(NUMBEROFEQUATIONS)
REDIM C(NUMBEROFEQUATIONS)

READ SCALEX
READ SCALEY
READ TVX
READ TVY

FOR N = 0 TO NUMBEROFEQUATIONS - 1
        READ D: A11(N) = D
        READ D: A12(N) = D
        READ D:  TX(N) = D
        READ D: A21(N) = D
        READ D: A22(N) = D
        READ D:  TY(N) = D
        READ D:   P(N) = D
        READ D:   C(N) = D

        NEXT

        RANDOMIZE TIMER
        REM PREPARE PROBABILITY ARRAY
        PROBABILITY(0) = 0
        FOR K = 1 TO NUMBEROFEQUATIONS
            PROBABILITY(K) = PROBABILITY(K - 1) + P(K - 1) * 100
            NEXT

REM SKIP FIRST ITERATIONS...
CLS
LOCATE 1, 1: PRINT "WAIT A SECOND. PREPARE TO DRAW: "; : PRINT IFSPNAME$
FOR ITERATIONS = 0 TO 1024
        N = INT(RND * NUMBEROFEQUATIONS)
        XN = A11(N) * XO + A12(N) * YO + TX(N)
        YN = A21(N) * XO + A22(N) * YO + TY(N)
        XO = XN
        YO = YN
        NEXT

SCREEN 12

REM     DRAW IFSP FRACTAL

DO:     R = INT(RND * 100)

        FOR K = 0 TO NUMBEROFEQUATIONS - 1
                IF R >= PROBABILITY(K) AND R < PROBABILITY(K + 1) THEN N = K: EXIT FOR
                NEXT

        XN = A11(N) * XO + A12(N) * YO + TX(N)
        YN = A21(N) * YO + A22(N) * YO + TY(N)

        IF COLOURFLAG = 1 THEN C = C(N) ELSE C = INT(RND * 15) + 1
        PSET (XN * SCALEX + TVX, YN * SCALEY + TVY), C
        XO = XN
        YO = YN
        LOOP WHILE INKEY$ = ""

GOSUB MENU
RETURN

