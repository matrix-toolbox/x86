REM FAST INCREMENTATION
REM 1994

CLS
DEF SEG = &HB800
DEFINT A-H

DO: FOR A = 48 TO 57: POKE 2, A
    FOR B = 48 TO 57: POKE 4, B
    FOR C = 48 TO 57: POKE 6, C
    FOR D = 48 TO 57: POKE 8, D

    REM IF INKEY$ <> "" THEN END

    FOR E = 48 TO 57: POKE 10, E
    FOR F = 48 TO 57: POKE 12, F
    FOR G = 48 TO 57: POKE 14, G
    FOR H = 48 TO 57: POKE 16, H

    NEXT: NEXT: NEXT: NEXT: NEXT: NEXT: NEXT: NEXT

    LOOP WHILE INKEY$ = ""

