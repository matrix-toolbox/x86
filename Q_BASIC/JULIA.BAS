REM THE ORIGINAL CODE WRITTEN
REM WITHOUT ANY MATH. BACKGROUND AT THAT TIME
REM AFTER A RATHER LONG LECTURE OF THE [GREAT] BOOK:
REM J. KUDREWICZ, "FRAKTALE I CHAOS", WN-T (1993)

SCREEN 12
cr = -.84: ci = .19: L = 0: X = -1.75: Y = -1.75
DO WHILE INKEY$ = "": re = X: im = Y
DO: RE1 = re * re - im * im + cr: IM1 = 2 * im * re + ci
REM IF ABS(re1 + im1) >= 3 THEN 1
    IF RE1 * RE1 + IM1 * IM1 >= 4 THEN 1
L = L + 1: IF L = 64 THEN 0
re = RE1: im = IM1: LOOP
0 PSET (X * 100 + 300, Y * 100 + 220), 0: GOTO 3
1 PSET (X * 100 + 300, Y * 100 + 220), 1 + L MOD 15
3
X = X + .01: IF X > 1.75 THEN X = -1.75: Y = Y + .01
IF Y > 1.75 THEN BEEP: SLEEP: END
L = 0: LOOP

