.MODEL tiny
.code
	org 100h
start:
	mov ax, 0003h
	int 10h
	mov ah, 01h
	mov cx, 2607h
	int 10h
	mov al, 10h
	mov dx, 3c0h
	out dx, al
	in al, dx
	and al, 00000100b
	out dx, al
	push cs
	pop es
	mov bp, offset ASCII_NEW
	mov cx, 250d
	xor dx, dx      ; start at ASCII 0
	mov bx, 1000h   ; matrix size: 8 x 10h
	mov ax, 1100h
	int 10h
	push di
	push si
	push cs
	pop ds
	mov ax, 0b800h
	mov es, ax
	mov si, offset ASCII_MAP
	xor di, di
	mov cx, 2000d
LOAD_ASCII:
	mov al, [si]
	mov es:[di], al
	inc si
	inc di
	inc di
	loop LOAD_ASCII
	pop si
	pop di
LOOP_UNTIL_ESC:
	in al, 60h
	cmp al, 1
	jne LOOP_UNTIL_ESC
	mov ax, 0003h
	int 10h
	mov ax, 4C00h
	int 21h

; DB data that follow are generated by ASCII[.c]

